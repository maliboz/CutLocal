<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CutLocal</AssemblyName>
    <RootNamespace>CutLocal.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\CutLocal.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CutLocal.Application\CutLocal.Application.csproj" />
    <ProjectReference Include="..\CutLocal.Contracts\CutLocal.Contracts.csproj" />
    <ProjectReference Include="..\CutLocal.Domain\CutLocal.Domain.csproj" />
    <ProjectReference Include="..\CutLocal.Infrastructure\CutLocal.Infrastructure.csproj" />
    <ProjectReference Include="..\CutLocal.Persistence\CutLocal.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\branding\cutlocal-logo.png">
      <Link>Assets\cutlocal-logo.png</Link>
    </Resource>
    <Content Include="..\..\assets\models\manifests\*.json">
      <Link>assets\models\manifests\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\ThirdPartyNotices.txt">
      <Link>ThirdPartyNotices.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
