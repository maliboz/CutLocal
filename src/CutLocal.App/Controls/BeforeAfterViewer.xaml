<UserControl x:Class="CutLocal.App.Controls.BeforeAfterViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Padding="10,5"
                Click="OnFitClicked"
                Content="{DynamicResource Preview.Fit}" />
        <TextBlock Margin="14,0,8,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource SecondaryText}"
                   Text="{DynamicResource Preview.Zoom}" />
        <Slider x:Name="ZoomSlider"
                Width="120"
                Minimum="10"
                Maximum="400"
                SmallChange="5"
                ValueChanged="OnZoomChanged" />
        <TextBlock x:Name="ZoomText"
                   Width="50"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource SecondaryText}" />
      </StackPanel>
      <ToggleButton Grid.Column="1"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{DynamicResource Preview.Mask}"
                    Content="{DynamicResource Preview.Mask}"
                    IsChecked="{Binding IsMaskVisible, ElementName=Root, Mode=TwoWay}" />
    </Grid>

    <Border Grid.Row="1"
            ClipToBounds="True"
            Background="#070B14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="9">
      <ScrollViewer x:Name="Viewport"
                    HorizontalScrollBarVisibility="Auto"
                    IsDeferredScrollingEnabled="True"
                    PanningMode="Both"
                    ScrollChanged="OnViewportScrolled"
                    VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PreviewCanvas"
              Width="640"
              Height="420"
              Background="{StaticResource CheckerboardBrush}"
              Cursor="Arrow"
              MouseLeftButtonDown="OnCanvasMouseDown"
              MouseLeftButtonUp="OnCanvasMouseUp"
              MouseMove="OnCanvasMouseMove"
              MouseWheel="OnCanvasMouseWheel">
          <Image x:Name="BeforeImage"
                 Source="{Binding BeforeSource, ElementName=Root}"
                 Stretch="Fill"
                 SnapsToDevicePixels="True" />
          <Image x:Name="AfterImage"
                 Source="{Binding AfterSource, ElementName=Root}"
                 Stretch="Fill"
                 SnapsToDevicePixels="True" />
          <Image x:Name="MaskImage"
                 Source="{Binding MaskSource, ElementName=Root}"
                 Stretch="Fill"
                 SnapsToDevicePixels="True"
                 Visibility="Collapsed" />
          <Border x:Name="SplitDivider"
                  Width="2"
                  HorizontalAlignment="Left"
                  Background="White"
                  IsHitTestVisible="False">
            <Border.Effect>
              <DropShadowEffect BlurRadius="6" Opacity="0.55" ShadowDepth="0" />
            </Border.Effect>
          </Border>
          <Grid x:Name="ComparisonLabels" Margin="12" IsHitTestVisible="False">
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="9,5"
                    Background="#B3121828"
                    CornerRadius="5">
              <TextBlock FontWeight="SemiBold" Text="{DynamicResource Preview.Before}" />
            </Border>
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Padding="9,5"
                    Background="#B3121828"
                    CornerRadius="5">
              <TextBlock FontWeight="SemiBold" Text="{DynamicResource Preview.After}" />
            </Border>
          </Grid>
          <StackPanel x:Name="EmptyState"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False">
            <Image Width="48"
                   Height="48"
                   Opacity="0.38"
                   Source="/CutLocal;component/Assets/cutlocal-logo.png"
                   Stretch="Uniform" />
            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource SecondaryText}"
                       Text="{DynamicResource Preview.Empty}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Border>

    <Slider x:Name="SplitSlider"
            Grid.Row="2"
            Margin="0,12,0,0"
            Minimum="0"
            Maximum="1"
            SmallChange="0.02"
            Value="0.5"
            ValueChanged="OnSplitChanged" />
  </Grid>
</UserControl>
