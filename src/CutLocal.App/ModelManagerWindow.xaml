<Window x:Class="CutLocal.App.ModelManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Model.Title}"
        Icon="/CutLocal;component/Assets/cutlocal-logo.png"
        Width="1060"
        Height="720"
        MinWidth="860"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="OnLoaded"
        Closing="OnClosing">
  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="24,18"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Width="42"
                 Height="42"
                 AutomationProperties.Name="{DynamicResource App.Title}"
                 SnapsToDevicePixels="True"
                 Source="/CutLocal;component/Assets/cutlocal-logo.png"
                 Stretch="Uniform" />
          <StackPanel Margin="12,0,0,0">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="{DynamicResource Model.Title}" />
            <TextBlock Margin="0,5,0,0"
                       Style="{StaticResource SecondaryText}"
                       Text="{DynamicResource Model.PrivacyHint}" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1"
                MinWidth="180"
                Padding="14,8"
                Style="{StaticResource PrimaryButton}"
                Command="{Binding ImportCommand}"
                Content="{DynamicResource Model.Import}" />
      </Grid>
    </Border>

    <ListView x:Name="ModelCatalogList"
              Grid.Row="1"
              Margin="18"
              Padding="0"
              Background="Transparent"
              BorderThickness="0"
              ItemsSource="{Binding Models}"
              ScrollViewer.CanContentScroll="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border Padding="18"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="250" />
              </Grid.ColumnDefinitions>

              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="17"
                             FontWeight="SemiBold"
                             Text="{Binding Descriptor.DisplayName}" />
                  <Border Margin="10,0,0,0" Padding="8,2" Style="{StaticResource PillBorder}">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding StateText}" />
                  </Border>
                </StackPanel>
                <TextBlock Margin="0,7,0,0" Style="{StaticResource SecondaryText}">
                  <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource SecondaryText}"
                           Text="{Binding LicenseText}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LicenseText}" />
                <ProgressBar Margin="0,12,0,0"
                             Height="7"
                             Maximum="1"
                             Value="{Binding ProgressValue}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="22,0">
                <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource Model.Providers}" />
                <TextBlock Margin="0,5,0,0"
                           FontWeight="SemiBold"
                           Text="{Binding ProviderText}" />
                <TextBlock Margin="0,15,0,0" Style="{StaticResource SecondaryText}" Text="{DynamicResource Model.Input}" />
                <TextBlock Margin="0,5,0,0" FontWeight="SemiBold">
                  <Run Text="{Binding Descriptor.Input.Width, Mode=OneWay}" /><Run Text="×" /><Run Text="{Binding Descriptor.Input.Height, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>

              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding DownloadCommand}" Content="{DynamicResource Model.DownloadResume}" />
                <Button Grid.Column="2" Command="{Binding PauseOperationCommand}" Content="{DynamicResource Model.Pause}" />
                <Button Grid.Row="1" Margin="0,8,0,0" Command="{Binding RepairCommand}" Content="{DynamicResource Model.Repair}" />
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,8,0,0"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteCommand}"
                        Content="{DynamicResource Model.Delete}" />
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <Border Grid.Row="2"
            Padding="18,12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" />
          <TextBlock Text="{Binding StatusText}" />
        </StackPanel>
        <Button Grid.Column="1"
                MinWidth="110"
                Padding="12,6"
                IsCancel="True"
                Content="{DynamicResource Model.Close}" />
      </Grid>
    </Border>
  </Grid>
</Window>
