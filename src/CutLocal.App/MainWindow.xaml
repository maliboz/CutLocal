<Window x:Class="CutLocal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CutLocal.App.Controls"
        Title="{DynamicResource App.Title}"
        Icon="/CutLocal;component/Assets/cutlocal-logo.png"
        Width="1380"
        Height="860"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Loaded="OnLoaded"
        Closing="OnClosing"
        DragEnter="OnDragEnter"
        DragLeave="OnDragLeave"
        DragOver="OnDragOver"
        Drop="OnDrop">
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding SelectInputCommand}" />
    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ProcessCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>

  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="24,17"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="BrandLogo"
                 Width="38"
                 Height="38"
                 AutomationProperties.Name="{DynamicResource App.Title}"
                 SnapsToDevicePixels="True"
                 Source="/CutLocal;component/Assets/cutlocal-logo.png"
                 Stretch="Uniform" />
          <StackPanel Margin="12,0,0,0">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{DynamicResource App.Title}" />
            <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource App.Privacy}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource PillBorder}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,7,0" Fill="{StaticResource SuccessBrush}" />
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource Meta.Offline}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Margin="0,0,0,12"
              Padding="5"
              HorizontalAlignment="Left"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <StackPanel Orientation="Horizontal">
          <Button MinWidth="132"
                  Padding="14,7"
                  Command="{Binding ShowSingleModeCommand}"
                  Content="{DynamicResource Mode.Single}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSingleMode}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button MinWidth="132"
                  Margin="6,0,0,0"
                  Padding="14,7"
                  Command="{Binding ShowBatchModeCommand}"
                  Content="{DynamicResource Mode.Batch}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button MinWidth="168"
                  Margin="6,0,0,0"
                  Padding="14,7"
                  Command="{Binding OpenModelManagerCommand}"
                  Content="{DynamicResource Model.Title}" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Style="{StaticResource CardBorder}"
              Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Input.Title}" />

          <Border Grid.Row="1"
                  Margin="0,4,0,14"
                  Padding="14"
                  CornerRadius="9"
                  Background="{StaticResource SurfaceRaisedBrush}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDropActive}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="#272252" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <StackPanel VerticalAlignment="Center"
                          Visibility="{Binding HasInput, Converter={StaticResource InverseBooleanConverter}}">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="38"
                           Foreground="{StaticResource AccentHoverBrush}"
                           Text="＋" />
                <TextBlock Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{DynamicResource Input.DropTitle}" />
                <TextBlock Margin="0,7,0,0"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SecondaryText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{DynamicResource Input.DropHint}" />
              </StackPanel>

              <Grid Visibility="{Binding HasInput, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border ClipToBounds="True" CornerRadius="7" Background="#080C16">
                  <Image Source="{Binding BeforePreview}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                  <TextBlock FontWeight="SemiBold" Text="{Binding InputFileName}" ToolTip="{Binding InputPath}" />
                  <Button Margin="0,9,0,0"
                          Padding="10,6"
                          Command="{Binding ClearInputCommand}"
                          Content="{DynamicResource Action.Clear}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>

          <StackPanel Grid.Row="2">
            <Button Command="{Binding SelectInputCommand}"
                    AutomationProperties.Name="{DynamicResource Action.Browse}"
                    Content="{DynamicResource Action.Browse}" />
            <Button Margin="0,8,0,0"
                    Command="{Binding PasteCommand}"
                    AutomationProperties.Name="{DynamicResource Action.Paste}"
                    Content="{DynamicResource Action.Paste}" />
            <Button Margin="0,14,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ProcessCommand}"
                    AutomationProperties.Name="{DynamicResource Action.Process}"
                    Content="{DynamicResource Action.Process}" />
            <Button Margin="0,8,0,0"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding CancelCommand}"
                    Content="{DynamicResource Action.Cancel}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="0"
              Style="{StaticResource CardBorder}"
              Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Batch.Title}" />
          <Border Grid.Row="1"
                  Margin="0,4,0,14"
                  Padding="16"
                  Background="{StaticResource SurfaceRaisedBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="9">
            <StackPanel VerticalAlignment="Center">
              <TextBlock HorizontalAlignment="Center"
                         FontWeight="SemiBold"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Text="{DynamicResource Batch.DropTitle}" />
              <TextBlock Margin="0,5,0,0"
                         HorizontalAlignment="Center"
                         Style="{StaticResource SecondaryText}"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Text="{DynamicResource Batch.DropHint}" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2">
            <Button Command="{Binding Batch.AddFilesCommand}" Content="{DynamicResource Batch.AddFiles}" />
            <Button Margin="0,8,0,0"
                    Command="{Binding Batch.AddFolderCommand}"
                    Content="{DynamicResource Batch.AddFolder}" />
            <CheckBox Margin="0,9,0,0"
                      IsChecked="{Binding Batch.IncludeSubfolders}"
                      IsEnabled="{Binding Batch.CanEdit}"
                      Content="{DynamicResource Batch.IncludeSubfolders}" />
            <Button Margin="0,14,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding Batch.StartBatchCommand}"
                    Content="{DynamicResource Batch.Start}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Command="{Binding Batch.PauseBatchCommand}" Content="{DynamicResource Batch.Pause}" />
              <Button Grid.Column="2" Command="{Binding Batch.ResumeBatchCommand}" Content="{DynamicResource Batch.Resume}" />
            </Grid>
            <Button Margin="0,8,0,0"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding Batch.CancelBatchCommand}"
                    Content="{DynamicResource Action.Cancel}" />
            <Separator Margin="0,13" Background="{StaticResource BorderBrush}" />
            <Button Command="{Binding Batch.RetryFailedCommand}" Content="{DynamicResource Batch.RetryFailed}" />
            <Button Margin="0,8,0,0"
                    Command="{Binding Batch.RemoveSelectedCommand}"
                    Content="{DynamicResource Batch.RemoveSelected}" />
            <Button Margin="0,8,0,0"
                    Command="{Binding Batch.ClearBatchCommand}"
                    Content="{DynamicResource Action.Clear}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Style="{StaticResource CardBorder}"
              Padding="14"
              Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Preview.Title}" />
          <controls:BeforeAfterViewer Grid.Row="1"
                                      BeforeSource="{Binding BeforePreview}"
                                      AfterSource="{Binding AfterPreview}"
                                      MaskSource="{Binding MaskPreview}" />
        </Grid>
      </Border>

      <Border Grid.Column="2"
              Style="{StaticResource CardBorder}"
              Padding="14"
              Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Batch.Queue}" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource SecondaryText}"
                       Text="{Binding Batch.SummaryText}" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,10,0,0">
            <ListView x:Name="BatchQueueList"
                      ItemsSource="{Binding Batch.Items}"
                      Background="{StaticResource SurfaceRaisedBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">
              <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                  <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                  <Setter Property="BorderThickness" Value="0,0,1,1" />
                  <Setter Property="Padding" Value="8,7" />
                </Style>
                <Style TargetType="ListViewItem">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                  <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                  <Setter Property="BorderThickness" Value="0,0,0,1" />
                  <Setter Property="Padding" Value="2,4" />
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="Background" Value="#302967" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListView.Resources>
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="34">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected}" />
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="170" Header="{DynamicResource Batch.File}" DisplayMemberBinding="{Binding FileName}" />
                  <GridViewColumn Width="120" Header="{DynamicResource Batch.Status}" DisplayMemberBinding="{Binding StatusText}" />
                  <GridViewColumn Width="150" Header="{DynamicResource Batch.Progress}">
                    <GridViewColumn.CellTemplate>
                      <DataTemplate>
                        <Grid Margin="3,0">
                          <ProgressBar Height="15" Maximum="1" Value="{Binding Progress}" />
                          <TextBlock HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Text="{Binding ProgressText}" />
                        </Grid>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="78" Header="{DynamicResource Batch.Elapsed}" DisplayMemberBinding="{Binding ElapsedText}" />
                  <GridViewColumn Width="65" Header="{DynamicResource Batch.Attempts}" DisplayMemberBinding="{Binding AttemptCount}" />
                  <GridViewColumn Width="110" Header="{DynamicResource Batch.Provider}" DisplayMemberBinding="{Binding ProviderText}" />
                  <GridViewColumn Width="190" Header="{DynamicResource Batch.Error}" DisplayMemberBinding="{Binding ErrorText}" />
                </GridView>
              </ListView.View>
            </ListView>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasItems, ElementName=BatchQueueList, Converter={StaticResource InverseBooleanConverter}}">
              <TextBlock HorizontalAlignment="Center"
                         FontSize="34"
                         Foreground="{StaticResource BorderBrush}"
                         Text="≡" />
              <TextBlock Margin="0,8,0,0"
                         Style="{StaticResource SecondaryText}"
                         Text="{DynamicResource Batch.Empty}" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
          <StackPanel Margin="18">
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Title}" />

            <TextBlock Margin="0,4,0,6" Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.Model}" />
            <ComboBox ItemsSource="{Binding Models}"
                      SelectedItem="{Binding SelectedModel}"
                      IsEnabled="{Binding IsIdle}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Foreground="#111827" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                    <TextBlock Foreground="#4B5563" FontSize="11" Text="{Binding Detail}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Margin="0,14,0,6" Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.Provider}" />
            <ComboBox ItemsSource="{Binding Providers}"
                      SelectedItem="{Binding SelectedProvider}"
                      IsEnabled="{Binding IsIdle}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Foreground="#111827" Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Separator Margin="0,18" Background="{StaticResource BorderBrush}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Output}" />
            <TextBlock Margin="0,2,0,6" Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.OutputFolder}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox IsReadOnly="True" Text="{Binding OutputDirectory}" ToolTip="{Binding OutputDirectory}" />
              <Button Grid.Column="1"
                      Width="42"
                      Margin="7,0,0,0"
                      Command="{Binding BrowseOutputFolderCommand}"
                      ToolTip="{DynamicResource Action.BrowseFolder}"
                      Content="…" />
            </Grid>

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Margin="0,0,0,6" Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.Suffix}" />
                <TextBox Text="{Binding FileNameSuffix, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,6" Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.Format}" />
                <TextBox IsReadOnly="True" Text="PNG · RGBA" />
              </StackPanel>
            </Grid>

            <TextBlock Margin="0,12,0,6" Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.Existing}" />
            <ComboBox ItemsSource="{Binding ExistingOutputOptions}"
                      SelectedValuePath="Behavior"
                      SelectedValue="{Binding ExistingOutputBehavior}"
                      IsEnabled="{Binding IsIdle}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Foreground="#111827" Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox IsChecked="True" IsEnabled="False" Content="{DynamicResource Settings.PreserveDimensions}" />

            <Separator Margin="0,18" Background="{StaticResource BorderBrush}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Settings.Edge}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.Threshold}" />
              <TextBlock Grid.Column="1" Text="{Binding Threshold, StringFormat={}{0:F2}}" />
            </Grid>
            <Slider Margin="0,6,0,2"
                    Minimum="0"
                    Maximum="1"
                    TickFrequency="0.01"
                    Value="{Binding Threshold}"
                    IsEnabled="{Binding IsIdle}" />

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.Feather}" />
              <TextBlock Grid.Column="1" Text="{Binding FeatherRadius, StringFormat={}{0:F1} px}" />
            </Grid>
            <Slider Margin="0,6,0,2"
                    Minimum="0"
                    Maximum="24"
                    TickFrequency="0.5"
                    Value="{Binding FeatherRadius}"
                    IsEnabled="{Binding IsIdle}" />
            <CheckBox IsChecked="{Binding HardCut}" IsEnabled="{Binding IsIdle}" Content="{DynamicResource Settings.HardCut}" />
            <CheckBox IsChecked="{Binding InvertMask}" IsEnabled="{Binding IsIdle}" Content="{DynamicResource Settings.Invert}" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource Settings.EdgeHint}" />
            <CheckBox IsChecked="{Binding IsLivePreviewEnabled}"
                      Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Content="{DynamicResource Settings.LivePreview}" />

            <StackPanel Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Separator Margin="0,18" Background="{StaticResource BorderBrush}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Batch.Concurrency}" />
                <TextBlock Grid.Column="1" Text="{Binding BatchConcurrency}" />
              </Grid>
              <Slider Margin="0,8,0,0"
                      Minimum="1"
                      Maximum="2"
                      TickFrequency="1"
                      IsSnapToTickEnabled="True"
                      Value="{Binding BatchConcurrency}"
                      IsEnabled="{Binding IsIdle}" />
              <TextBlock Margin="0,7,0,0"
                         Style="{StaticResource SecondaryText}"
                         TextWrapping="Wrap"
                         Text="{DynamicResource Batch.SafetyHint}" />
            </StackPanel>

            <Separator Margin="0,18" Background="{StaticResource BorderBrush}" />
            <TextBlock Margin="0,0,0,6" Style="{StaticResource SecondaryText}" Text="{DynamicResource Settings.Language}" />
            <ComboBox ItemsSource="{Binding Cultures}"
                      SelectedItem="{Binding SelectedCulture}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Foreground="#111827" Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </ScrollViewer>
      </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2"
            Padding="18,12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ProgressBar Maximum="1"
                     Value="{Binding ProgressValue}"
                     Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Grid Grid.Row="1"
              Margin="0,10,0,0"
              Visibility="{Binding IsSingleMode, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryText}"
                       Text="{Binding OutputPath}"
                       ToolTip="{Binding OutputPath}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource SecondaryText}">
            <Run Text="{DynamicResource Meta.Provider}" /><Run Text=": " /><Run Text="{Binding LastProviderText}" />
          </TextBlock>
          <TextBlock Grid.Column="2" Margin="18,0,0,0" Style="{StaticResource SecondaryText}">
            <Run Text="{DynamicResource Meta.Elapsed}" /><Run Text=": " /><Run Text="{Binding LastElapsedText}" />
          </TextBlock>
          <Button Grid.Column="3"
                  Margin="18,0,0,0"
                  Padding="10,5"
                  Command="{Binding OpenOutputFolderCommand}"
                  Content="{DynamicResource Action.OpenFolder}" />
        </Grid>
        <ProgressBar Maximum="1"
                     Value="{Binding Batch.OverallProgress}"
                     Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Grid Grid.Row="1"
              Margin="0,10,0,0"
              Visibility="{Binding IsBatchMode, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding Batch.StatusText}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Margin="18,0,0,0" Style="{StaticResource SecondaryText}">
            <Run Text="{DynamicResource Batch.Summary}" /><Run Text=": " /><Run Text="{Binding Batch.SummaryText}" />
          </TextBlock>
          <Button Grid.Column="2"
                  Margin="18,0,0,0"
                  Padding="10,5"
                  Command="{Binding Batch.OpenBatchOutputFolderCommand}"
                  Content="{DynamicResource Action.OpenFolder}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
