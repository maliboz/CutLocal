<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == 'win-x64'">osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <SelfContained>true</SelfContained>
    <AssemblyName>CutLocal</AssemblyName>
    <RootNamespace>CutLocal.Mac</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CutLocal.Application\CutLocal.Application.csproj" />
    <ProjectReference Include="..\CutLocal.Contracts\CutLocal.Contracts.csproj" />
    <ProjectReference Include="..\CutLocal.Domain\CutLocal.Domain.csproj" />
    <ProjectReference Include="..\CutLocal.Infrastructure\CutLocal.Infrastructure.csproj" />
    <ProjectReference Include="..\CutLocal.Persistence\CutLocal.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\branding\cutlocal-logo.png">
      <Link>Assets\cutlocal-logo.png</Link>
    </AvaloniaResource>
    <Content Include="..\..\assets\models\manifests\*.json">
      <Link>assets\models\manifests\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\ThirdPartyNotices.txt">
      <Link>ThirdPartyNotices.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
